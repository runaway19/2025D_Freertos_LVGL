# =================================================
# GUI Guider & LVGL Simulator 专用
# =================================================
# 忽略仿真编译生成的二进制文件夹
build/
bin/
lib/

# 忽略 GUI Guider 的运行日志
*.log

# 忽略仿真器内部的中间产物
lvgl-simulator/build/
lvgl-simulator/bin/
lvgl-simulator/lib/

